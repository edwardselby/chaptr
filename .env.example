# CHAPTR Environment Configuration
# Copy this file to .env and update values for your environment
#
# For Docker deployment: cp .env.example .env && nano .env

# =============================================================================
# DOCKER DEPLOYMENT NOTE
# =============================================================================
# When using docker-compose.yml on the origami.work server, most variables
# below are OVERRIDDEN by docker-compose.yml and should be changed there.
#
# Only these variables are loaded from .env in Docker:
#   - SECRET_KEY
#   - ADMIN_USERNAME
#   - ADMIN_PASSWORD
#
# All other settings (MongoDB URL, CORS, etc.) are set in docker-compose.yml
# =============================================================================

# =============================================================================
# Security - REQUIRED for Docker deployment
# =============================================================================
# Generate secure key with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-change-in-production

# =============================================================================
# Admin User Initialization - REQUIRED for Docker deployment
# =============================================================================
# Admin user will be created automatically on first run
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password-here

# =============================================================================
# LOCAL DEVELOPMENT SETTINGS (ignored when using Docker)
# =============================================================================
# These settings are used for local development without Docker.
# They are overridden by docker-compose.yml environment section.

# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=chaptr

# Application Settings
DEBUG=true
ENVIRONMENT=development

# Security
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Multi-Currency
BASE_CURRENCY=GBP

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Change Log Pruning
CHANGE_LOG_RETENTION_DAYS=31
